# Copy to .env, which git ignores, and fill in what you need. `make run`, `make fresh`
# and `make dev` read it. All lines are optional.

# Adds Anthropic's models to the picker. Choosing one spends from this key.
# From the Claude Console (console.anthropic.com), billed separately from a Claude.ai subscription.
ANTHROPIC_API_KEY=

# Where the local model answers, if not llama.cpp's default. For Ollama: http://localhost:11434
# CLIENT_LOCAL_MODEL_URL=

# How long an idle session survives, as a Go duration such as 24h. Unset, sessions never expire.
# CLIENT_SESSION_TTL=

# Set to true behind HTTPS, where a proxy terminates TLS in front of CaseWork. Adds Secure to both cookies.
# CLIENT_SECURE_COOKIES=
