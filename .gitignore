# Binaries and build output
# Go names a binary after its directory, so each module needs its own entry —
# and so does any `-o` target, which is what `make build` uses. Unanchored `bin/`
# catches the next one without anyone having to remember.
bin/
/flowcore
/client/client
*.exe

# Env / local secrets
.env
.env.local

# Test & coverage output
*.out
coverage.*

# OS noise
.DS_Store

# Editor
.vscode/*
!.vscode/settings.json

# OpenTofu state and plugins stay on the owner's machine (client decision 51);
# the lock file does not, so providers are pinned.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Agent session handover: local working state, rewritten every session
docs/pending-tasks/agent-handover.md
